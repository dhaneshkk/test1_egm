# Copy to .env (never commit it). In the cloud, keep these in the provider's secrets store.
EGM_DOMAIN=egm-team.example.com
POSTGRES_PASSWORD=change-me
EGM_DATABASE_URL=host=postgres user=egm dbname=egm password=change-me
VESDB_APP_TOKEN=change-me-at-least-32-characters-long-000000
EGM_VESDB_TOKEN=change-me-at-least-32-characters-long-000000
EGM_GITHUB_CLIENT_SECRET=change-me
EGM_HOST_TOKEN_FIELD_TEST=change-me          # GitHub fine-grained token: contents write (egm-dsh/* branches), pull requests, commit statuses
EGM_WEBHOOK_SECRET_FIELD_TEST=change-me-at-least-20-chars
EGM_SMTP_PASSWORD=change-me
DEEPSEEK_API_KEY=change-me
# EGM_VESDB_REDACT_TOKEN is not here on purpose: only an admin running `egm-team redact` holds it.
